  { brand: "OXXO", opportunity: "tiendas_conveniencia", expectedStudyN: 23_534, identityOverlay: true },
  { brand: "Farmacias Guadalajara", opportunity: "farmacia", expectedStudyN: 2_956, identityOverlay: true },
