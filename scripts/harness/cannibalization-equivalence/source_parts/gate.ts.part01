] as const;

type Poi = Record<string, any> & { id: string; lat: number; lng: number; category: string; source?: string };
type SnapshotCell = { cell_id: string; path: string; sha256: string; bytes: number; poi_count: number; provenance: string };
type SnapshotIndex = {
  schema: string;
  active_base_version: string;
  active_base_url: string;
  authorities: { manifest: { path: string }; identity: { path: string; sha256: string } };
  cells: SnapshotCell[];
};

type Args = { runtimeRoot: string; snapshotIndex: string; storeLevel: string; outDir: string };

type Runtime = {
  dedupeDenuePois: (pois: Poi[], thresholdM?: number, strongAddressThresholdM?: number) => Poi[];
  normalizeExactName: (s: string | null | undefined) => string;
  applyDenueCanonicalAuthority: (pois: Poi[]) => Poi[];
  cleanCanonicalCompetitionPois: (pois: Poi[]) => Poi[];
  getBrandSearchPois: (pois: Poi[], opportunity: string | null | undefined, targetBrand?: string | null) => Poi[];
  matchBrand: (brand: string, poi: { name?: string | null; brand?: string | null }) => boolean;
  parseIdentityEntityMapDocument: (v: unknown) => any | null;
  isIdentityEntityMapOpportunity: (s: string | null | undefined) => boolean;
  resolveCellsForPoint: (lat: number, lng: number, radiusM: number) => Array<{ id: string }>;
  resolveHomeCell: (lat: number, lng: number) => { id: string; latIndex: number; lngIndex: number };
  haversineDistance: (aLat: number, aLng: number, bLat: number, bLng: number) => number;
  applyEmpleadosLookup: (pois: Poi[], lookup: Map<string, number>) => Poi[];
};

function die(msg: string): never { throw new Error(`ABORT: ${msg}`); }
function log(msg = "") { console.log(msg); }
function ensureDir(p: string) { mkdirSync(p, { recursive: true }); }
function shaBytes(b: Buffer | string): string { return createHash("sha256").update(b).digest("hex"); }
function shaFile(p: string): string { return shaBytes(readFileSync(p)); }
function atomicWrite(p: string, body: string | Buffer) {
  ensureDir(path.dirname(p));
  const tmp = `${p}.partial`;
  writeFileSync(tmp, body);
  renameSync(tmp, p);
}
function atomicJson(p: string, value: any) { atomicWrite(p, JSON.stringify(value, null, 2) + "\n"); }

function parseArgs(argv: string[]): Args {
  const map = new Map<string, string>();
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--help" || a === "-h") {
      console.log(`Usage: bun gate.ts --runtime-root <lantivo-vf> --snapshot-index <SNAPSHOT_INDEX.json> --store-level <V1.3_STORE_LEVEL.csv> --out-dir <dir>`);
      process.exit(0);
    }
    if (!a.startsWith("--")) die(`unexpected arg ${a}`);
    const v = argv[++i];
    if (!v) die(`missing value for ${a}`);
    map.set(a, v);
  }
  const runtimeRoot = map.get("--runtime-root");
  const snapshotIndex = map.get("--snapshot-index");
  const storeLevel = map.get("--store-level");
  const outDir = map.get("--out-dir");
  if (!runtimeRoot || !snapshotIndex || !storeLevel || !outDir) die("required args missing; use --help");
  return { runtimeRoot: path.resolve(runtimeRoot), snapshotIndex: path.resolve(snapshotIndex), storeLevel: path.resolve(storeLevel), outDir: path.resolve(outDir) };
}

function git(root: string, args: string[]): string {
  return execFileSync("git", ["-C", root, ...args], { encoding: "utf8" }).trim();
}

