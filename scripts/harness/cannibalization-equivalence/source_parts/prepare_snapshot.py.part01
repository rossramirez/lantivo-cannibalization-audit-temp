USER_AGENT = "Lantivo-Canibalization-Equivalence-Gate-Readonly/1.0"
RETRYABLE_HTTP = {408, 425, 429, 500, 502, 503, 504}


def die(msg: str, code: int = 2) -> None:
    raise SystemExit(f"ABORT: {msg}")


def log(msg: str = "") -> None:
    print(msg, flush=True)


def sha256_bytes(body: bytes) -> str:
    return hashlib.sha256(body).hexdigest().lower()


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest().lower()


def atomic_write(path: Path, body: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".partial")
    tmp.write_bytes(body)
    os.replace(tmp, path)


def atomic_json(path: Path, obj: Any) -> None:
    atomic_write(path, (json.dumps(obj, ensure_ascii=False, sort_keys=True, indent=2) + "\n").encode("utf-8"))


def http_get(url: str, attempts: int = 5, timeout: float = 30.0) -> bytes:
    last: Exception | None = None
    for attempt in range(1, attempts + 1):
        req = urllib.request.Request(
            url,
            method="GET",
            headers={
                "User-Agent": USER_AGENT,
                "Cache-Control": "no-cache",
                "Pragma": "no-cache",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                if getattr(r, "status", 200) != 200:
                    raise RuntimeError(f"HTTP {getattr(r, 'status', '?')} {url}")
                return r.read()
        except urllib.error.HTTPError as e:
            last = e
            if e.code not in RETRYABLE_HTTP:
                raise
        except Exception as e:
            last = e
        if attempt < attempts:
            time.sleep(min(8.0, 0.7 * (2 ** (attempt - 1))))
    raise RuntimeError(f"GET failed after {attempts} attempts: {url}: {last}")


def parse_json_bytes(body: bytes, label: str) -> dict[str, Any]:
    try:
        obj = json.loads(body.decode("utf-8-sig"))
    except Exception as e:
        die(f"invalid JSON {label}: {e}")
    if not isinstance(obj, dict):
        die(f"{label} is not a JSON object")
    return obj


def count_cell_pois(path: Path, expected_cell_id: str | None = None) -> int:
    obj = parse_json_bytes(path.read_bytes(), str(path))
    pois = obj.get("pois")
    if not isinstance(pois, list):
        die(f"cell {path.name} missing pois array")
    if int(obj.get("poi_count", -1)) != len(pois):
        die(f"cell {path.name} poi_count mismatch")
    cid = obj.get("cell_id")
    expected = expected_cell_id or path.stem
    if cid != expected:
        die(f"cell_id/path mismatch {path.name}: {cid!r} != {expected!r}")
    return len(pois)


def verify_file(path: Path, expected_sha: str) -> None:
    if not path.is_file():
        die(f"missing frozen file: {path}")
    actual = sha256_file(path)
    if actual != expected_sha:
        die(f"frozen file SHA drift {path.name}: {actual} != {expected_sha}")


def load_prepare_inventory(prep_dir: Path) -> dict[str, dict[str, Any]]:
    report = prep_dir / "C2_BASE_REPAIR_PREPARE_V1_3_REPORT.json"
    summary = prep_dir / "C2_BASE_REPAIR_PREPARE_V1_3_SUMMARY.txt"
    hashes = prep_dir / "C2_BASE_REPAIR_PREPARE_V1_3_HASHES.txt"
    inv_path = prep_dir / "C2_BASE_REPAIR_PREPARE_V1_3_CELL_INVENTORY.csv"
